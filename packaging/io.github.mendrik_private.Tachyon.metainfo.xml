<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.mendrik_private.Tachyon</id>
  <name>Tachyon</name>
  <summary>Read and edit Markdown as a rich document</summary>
  <url type="homepage">https://github.com/mendrik-private/tachyon</url>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <developer id="io.github.mendrik_private">
    <name>Tachyon contributors</name>
  </developer>
  <description>
    <p>
      Tachyon is a native Wayland editor that presents Markdown as one
      continuously rendered, always-editable document. It includes rich tables,
      lists, links, images, an outline, a minimap, autosave, and crash recovery.
    </p>
  </description>
  <launchable type="desktop-id">io.github.mendrik_private.Tachyon.desktop</launchable>
  <provides>
    <binary>tachyon</binary>
    <mediatype>text/markdown</mediatype>
    <mediatype>text/x-markdown</mediatype>
  </provides>
  <content_rating type="oars-1.1" />
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>
  <releases>
    <release version="0.1.11" date="2026-09-14" />
    <release version="0.1.10" date="2026-09-14" />
    <release version="0.1.1" date="2026-09-11" />
    <release version="0.1.0" date="2026-09-11" />
  </releases>
</component>
